---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import { catalogo, totalServicios } from '../data/servicios';
import ServicePicker from '../components/ServicePicker.astro';
import ServiceMap from '../components/ServiceMap.astro';

const title = 'Servicios · Pablo Guzzi';
const description =
  'Estrategia, implementación, liderazgo fraccional, mentoría y formación en datos e IA. El catálogo completo de servicios de Pablo Guzzi, ex Chief Data & AI Officer en Ualá.';

const contactHref = SITE.formUrl || '/#contacto';
const ext = SITE.formUrl ? { target: '_blank', rel: 'noopener' } : {};

const formatos = [
  { t: 'Proyecto acotado', d: 'Alcance, entregables y plazo definidos desde el inicio.' },
  { t: 'Horas de advisory', d: 'Un set de horas mensuales para usar cuando las necesites.' },
  { t: 'Acompañamiento continuo', d: 'Presencia sostenida mientras la IA se vuelve parte de la operación.' },
];

const schema = {
  '@type': 'OfferCatalog',
  name: 'Servicios de datos e IA de Pablo Guzzi',
  itemListElement: catalogo.flatMap((g) =>
    g.items.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.t, description: s.d } })),
  ),
};
---
<Base title={title} description={description} schema={schema}>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="nav">
    <div class="wrap nav__in">
      <a class="mark" href="/" aria-label="Pablo Guzzi, inicio">pablo guzzi</a>
      <nav aria-label="Grupos de servicios">
        <ul class="nav__links">
          <li><a href="#top">Por situación</a></li>
          <li><a href="#mapa">Mapa</a></li>
          <li><a href="#catalogo">Catálogo completo</a></li>
        </ul>
      </nav>
      <a class="btn btn--sm" href={contactHref} {...ext} data-cta="svc-nav">Hablemos</a>
    </div>
  </header>

  <main id="contenido">
    <section class="hero grid-bg hero--compact" id="top">
      <div class="glow glow--hero" aria-hidden="true"></div>
      <div class="wrap">
        <p class="eyebrow">Servicios</p>
        <h1 class="h1--name">Empezá por <span class="hl">tu situación.</span></h1>
        <p class="lede">
          Tengo {totalServicios} servicios para llevar los datos y la IA de la estrategia a la operación. Elegí lo
          que más se parece a lo que te pasa y te muestro por dónde arrancar. Abajo está el catálogo completo.
        </p>
        <ServicePicker id="svc-pick" full />
      </div>
    </section>

    <section class="section" id="mapa" aria-labelledby="mapa-t">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Mapa de servicios</p>
            <h2 id="mapa-t">Dónde opera cada servicio <span class="hl">en tu empresa.</span></h2>
          </div>
          <p class="intro">
            De arriba hacia abajo, de la dirección a la operación. De izquierda a derecha, de decidir a
            sostener. Así ves qué parte de tu empresa toca cada servicio y en qué momento.
          </p>
        </div>
        <ServiceMap />
      </div>
    </section>

    <section class="section section--panel" id="catalogo" aria-labelledby="cat-t">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Catálogo completo</p>
            <h2 id="cat-t">Los {totalServicios} servicios, <span class="hl">por grupo.</span></h2>
          </div>
          <p class="intro">Filtrá por grupo y abrí cada servicio para ver para quién es y qué te llevás.</p>
        </div>
        <div class="cat__filters" role="group" aria-label="Filtrar por grupo">
          <button type="button" data-f="all" aria-pressed="true">Todos <span>{totalServicios}</span></button>
          {catalogo.map((g) => (
            <button type="button" data-f={g.id} aria-pressed="false">{g.t} <span>{g.items.length}</span></button>
          ))}
        </div>
        <div class="cat">
          {catalogo.map((g) => (
            <div class="cat__group" data-g={g.id} id={g.id}>
              <p class="cat__gt"><span class="kicker">{g.k}</span> {g.t}<span class="cat__gd">{g.d}</span></p>
              {g.items.map((s) => (
                <details class={`cat__item${s.href === '/ai-implementation' ? ' is-feature' : ''}`} id={`s${s.n}`}>
                  <summary>
                    <span class="cat__n">{s.n}</span>
                    <span class="cat__t"><strong>{s.t}</strong><span>{s.d}</span></span>
                    <span class="cat__x" aria-hidden="true"></span>
                  </summary>
                  <div class="cat__body">
                    <dl class="svc-card__meta">
                      <div><dt>Para quién</dt><dd>{s.para}</dd></div>
                      <div><dt>Qué te llevás</dt><dd>{s.out}</dd></div>
                    </dl>
                    {s.href ? (
                      <a class="btn btn--sm" href={s.href} data-cta={`svc-${s.n}`}>{s.cta}</a>
                    ) : (
                      <a class="more" href={contactHref} {...ext} data-cta={`svc-${s.n}`}>Consultar por este servicio <span aria-hidden="true">→</span></a>
                    )}
                  </div>
                </details>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="formatos-t">
      <div class="wrap">
        <p class="eyebrow">Formas de trabajo</p>
        <h2 id="formatos-t">Cada servicio se adapta <span class="hl">a tu momento.</span></h2>
        <div class="cards cards--3">
          {formatos.map((f) => (
            <article class="card card--bar">
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </article>
          ))}
        </div>
        <p class="note">
          Los servicios de implementación los hago junto a un equipo que diseña y construye, y estoy en cada
          proyecto de la primera conversación a la puesta en producción.
        </p>
      </div>
    </section>

    <section class="final grid-bg" id="contacto" aria-labelledby="final-t">
      <div class="glow glow--final" aria-hidden="true"></div>
      <div class="wrap final__in">
        <p class="eyebrow">Contacto</p>
        <h2 id="final-t">Contame dónde estás y <span class="hl">armamos el camino.</span></h2>
        <p>No hace falta que sepas qué servicio necesitás. Con dos líneas sobre tu situación alcanza.</p>
        <div class="actions actions--center">
          <a class="btn btn--glow" href={contactHref} {...ext} data-cta="svc-final">Hablemos</a>
          <a class="btn btn--ghost" href="/">Conocer a Pablo</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <p><span class="mark mark--sm">pablo guzzi</span></p>
      <p><a href="/">Inicio</a> · <a href="/prensa">Prensa y organizadores</a> · {SITE.city} · © {new Date().getFullYear()}</p>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('[data-f]');
      var groups = document.querySelectorAll('[data-g]');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          var f = b.getAttribute('data-f');
          btns.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
          groups.forEach(function (g) { g.hidden = f !== 'all' && g.getAttribute('data-g') !== f; });
        });
      });
      function openHash() {
        var el = location.hash && document.querySelector(location.hash);
        if (!el) return;
        if (el.tagName === 'DETAILS') { el.open = true; }
        var g = el.closest('[data-g]');
        if (g && g.hidden) { document.querySelector('[data-f="all"]').click(); }
        setTimeout(function () { el.scrollIntoView({ block: 'start' }); }, 30);
      }
      window.addEventListener('hashchange', openHash);
      openHash();
    })();
  </script>
</Base>
