---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import GatewayFlow from '../components/GatewayFlow.astro';

const title = 'Guzzi AI · AI Gateway para tu empresa';
const description =
  'Implementamos un AI Gateway en tu nube: una sola puerta para que toda tu empresa use cualquier modelo de IA con control de accesos, costos y datos. Liderado por Pablo Guzzi, ex Chief Data & AI Officer en Ualá.';

const ctaHref = SITE.formUrl || '#contacto';
const ext = SITE.formUrl ? { target: '_blank', rel: 'noopener' } : {};

const origenes = ['Apps y servicios', 'Agentes', 'Notebooks', 'Empleados'];
const controles = ['Identidad y permisos', 'Presupuestos y límites', 'Protección de datos', 'Ruteo y respaldo', 'Costo y auditoría'];
const destinos = ['OpenAI', 'Anthropic', 'Google Vertex AI', 'AWS Bedrock', 'Azure OpenAI', 'Modelos open source'];

const antesDespues = [
  { sin: 'Las claves de los proveedores copiadas en decenas de apps y laptops.', con: 'Las claves quedan cifradas en un solo lugar. Cada app y cada persona recibe un acceso propio que se revoca con un clic, o entra con el login de la empresa.' },
  { sin: 'Una factura sorpresa a fin de mes.', con: 'Topes de gasto por empresa, equipo, persona y aplicación, con alertas antes de llegar al límite y proyección a fin de mes.' },
  { sin: 'Nadie sabe quién usa qué modelo ni para qué.', con: 'Cada consulta registrada, con su costo por equipo, persona, modelo y cliente final, y reportes listos para imputar a cada centro de costo.' },
  { sin: 'Datos de clientes que viajan a un modelo externo sin control.', con: 'Detección de datos sensibles (DNI, CUIT, tarjetas, emails, claves) que se registran, se ocultan o se bloquean antes de salir.' },
  { sin: 'El proveedor elegido quedó escrito en el código.', con: 'Los equipos piden "el modelo rápido" o "el más inteligente" y vos decidís cuál atiende. Cambiar de proveedor no toca una línea de código.' },
  { sin: 'Si el proveedor se cae, se cae tu producto.', con: 'Respaldo automático hacia otro proveedor o región cuando uno falla o se satura.' },
];

const capacidades = [
  { k: 'Costos', t: 'FinOps de IA', d: 'Presupuestos en cuatro niveles, costo por request con tus precios negociados, costo por cliente o funcionalidad, reportes en pesos y en dólares, alertas de gasto anómalo y conciliación con las facturas reales.' },
  { k: 'Seguridad', t: 'Identidad y control', d: 'Login con el proveedor de identidad que ya usás (Okta, Entra ID, Google), altas y bajas automáticas, roles por grupo, modelos permitidos por equipo y auditoría completa.' },
  { k: 'Datos', t: 'Guardrails', d: 'Detección y ocultamiento de datos personales y secretos, más tus propias palabras y patrones, con reglas por organización y excepciones por equipo.' },
  { k: 'Libertad', t: 'Cualquier modelo', d: 'Compatible con las APIs de OpenAI y Anthropic. Se conecta a los principales proveedores y a modelos propios, con alias, respaldo automático y pruebas A/B entre modelos.' },
  { k: 'Agentes', t: 'Gateway para MCP', d: 'Los agentes acceden a herramientas y sistemas internos con los mismos permisos, controles de datos y registro que el resto de la IA.' },
  { k: 'Dirección', t: 'Vista ejecutiva', d: 'Adopción por equipo, tendencia y proyección de gasto, ahorro, principales casos de uso, calidad de las respuestas, disponibilidad por proveedor y un reporte mensual automático.' },
];

const porQue = [
  { t: 'La IA ya está en todas las áreas', d: 'Marketing, atención, legales y tecnología la usan cada uno a su manera. Sin una puerta común, no hay forma de saber cuánto cuesta, qué datos salen ni qué funciona.' },
  { t: 'Los agentes multiplican el consumo', d: 'Un agente hace decenas de llamadas por tarea y accede a sistemas internos. Gobernarlo después de que escale es mucho más caro que hacerlo antes.' },
  { t: 'Ningún modelo gana para siempre', d: 'El mejor modelo de hoy no va a ser el de dentro de seis meses. Con un gateway cambiás de proveedor cuando conviene, no cuando el contrato o el código te dejan.' },
];

const roles = [
  { k: 'Para el CFO', d: 'Gasto de IA previsible, imputado a cada área y conciliado con las facturas.' },
  { k: 'Para seguridad y riesgo', d: 'Datos sensibles bajo control, accesos con la identidad corporativa y todo auditado.' },
  { k: 'Para tecnología', d: 'Una sola integración, cualquier modelo, respaldo automático y métricas para operar.' },
  { k: 'Para la dirección', d: 'Una vista clara de quién adopta IA, cuánto cuesta y qué valor genera.' },
];

const pasos = [
  { t: 'Relevamiento', d: 'Mapeamos qué modelos se usan hoy, en qué equipos y aplicaciones, cuánto se gasta y qué datos salen.' },
  { t: 'Diseño', d: 'Definimos proveedores, alias de modelos, presupuestos, roles, reglas de datos y dónde va a correr.' },
  { t: 'Despliegue en tu nube', d: 'Lo instalamos en AWS, Google Cloud, Kubernetes o tu infraestructura, conectado a tu identidad y a tus proveedores.' },
  { t: 'Migración y adopción', d: 'Pasamos las aplicaciones al gateway, armamos los tableros y capacitamos a los equipos que lo van a operar.' },
];

const faqs = [
  { q: '¿Mis datos salen de la empresa?', a: 'El gateway corre en tu propia nube. Los datos solo van al proveedor de modelos que vos autorices, y las reglas de protección se aplican antes de que salgan.' },
  { q: '¿Reemplaza a OpenAI, Anthropic o Google?', a: 'No. Se pone delante de ellos. Seguís usando los modelos que quieras, ahora con control centralizado y la libertad de cambiar.' },
  { q: '¿Mis desarrolladores tienen que reescribir algo?', a: 'Casi nada. El gateway habla el mismo idioma que las APIs de OpenAI y Anthropic, así que alcanza con cambiar la dirección y la clave.' },
  { q: '¿Y si ya tenemos un gateway o elegimos otro?', a: 'Somos agnósticos. Tenemos un gateway propio listo para producción, y si tu empresa ya eligió otra herramienta, trabajamos sobre esa.' },
  { q: '¿Sirve para una empresa mediana?', a: 'Sí. Cuanto antes se ordena el uso de IA, más barato sale. El mismo gateway escala de un equipo a toda la compañía.' },
];

const schema = {
  '@type': 'Service',
  name: 'AI Gateway',
  serviceType: 'Implementación de AI Gateway',
  provider: { '@type': 'Organization', name: SITE.brand, founder: { '@type': 'Person', name: SITE.fullName } },
  areaServed: 'Latin America',
  url: new URL('/ai-implementation', SITE.url).toString(),
};
---
<Base title={title} description={description} ogImage="/og-ai.png" siteName={SITE.brand} schema={schema}>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="nav">
    <div class="wrap nav__in">
      <a class="mark" href="#top" aria-label="Guzzi AI, inicio de la sección">guzzi<span class="mark__ai">AI</span></a>
      <nav aria-label="Secciones">
        <ul class="nav__links">
          <li><a href="#que-es">Qué es</a></li>
          <li><a href="#que-permite">Qué permite</a></li>
          <li><a href="#como">Cómo lo implementamos</a></li>
          <li><a href="#preguntas">Preguntas</a></li>
          <li><a href="/servicios">Otros servicios</a></li>
        </ul>
      </nav>
      <a class="btn btn--sm" href={ctaHref} {...ext} data-cta="gw-nav">Quiero mi gateway</a>
    </div>
  </header>

  <main id="contenido">
    <!-- HERO -->
    <section class="hero grid-bg" id="top">
      <div class="glow glow--hero" aria-hidden="true"></div>
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">AI Gateway</p>
          <h1>Toda la IA de tu empresa, <span class="hl">por una sola puerta.</span></h1>
          <p class="lede">
            Implementamos un AI Gateway en tu nube: un único punto de entrada para que aplicaciones, equipos y
            agentes usen cualquier modelo, con control de accesos, de costos y de datos.
          </p>
          <div class="actions">
            <a class="btn btn--glow" href={ctaHref} {...ext} data-cta="gw-hero">Quiero mi gateway</a>
            <a class="btn btn--ghost" href="#que-es">Cómo funciona</a>
          </div>
          <ul class="chips" aria-label="Claves">
            <li>Cualquier modelo</li>
            <li>En tu nube</li>
            <li>Con tu login corporativo</li>
          </ul>
        </div>

        <figure class="gw" aria-label="Esquema: aplicaciones, agentes y personas pasan por el gateway antes de llegar a los proveedores de modelos">
          <ul class="gw__row gw__row--src">{origenes.map((o) => <li>{o}</li>)}</ul>
          <span class="gw__arrow" aria-hidden="true"></span>
          <div class="gw__core">
            <p class="gw__name"><span class="dot" aria-hidden="true"></span>AI Gateway</p>
            <ol class="gw__checks">{controles.map((c) => <li>{c}</li>)}</ol>
          </div>
          <span class="gw__arrow" aria-hidden="true"></span>
          <ul class="gw__row gw__row--dst">{destinos.map((d) => <li>{d}</li>)}</ul>
        </figure>
      </div>

      <div class="wrap">
        <p class="cred">
          <span>Liderado por <a href="/"><strong>Pablo Guzzi</strong></a></span>
          <span>Ex Chief Data &amp; AI Officer en Ualá (2021–2026)</span>
          <span>Ya implementado en una fintech a escala regional</span>
        </p>
      </div>
    </section>

    <!-- QUÉ ES -->
    <section class="section" id="que-es" aria-labelledby="que-es-t">
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Qué es</p>
            <h2 id="que-es-t">El plano de control de la <span class="hl">IA de tu empresa.</span></h2>
          </div>
          <p class="intro">
            Hoy cada equipo se conecta por su cuenta a OpenAI, Anthropic o Google. El gateway se pone en el
            medio: todas las llamadas pasan por él, y ahí se decide quién puede usar qué modelo, cuánto puede
            gastar y qué datos pueden salir.
          </p>
        </div>
        <GatewayFlow />
        <div class="vs" role="table" aria-label="Sin gateway y con gateway">
          <div class="vs__head" role="row">
            <span role="columnheader">Sin gateway</span>
            <span role="columnheader">Con AI Gateway</span>
          </div>
          {antesDespues.map((r) => (
            <div class="vs__row" role="row">
              <p class="vs__sin" role="cell">{r.sin}</p>
              <p class="vs__con" role="cell">{r.con}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- POR QUÉ ES EL FUTURO -->
    <section class="statement" aria-label="Por qué importa">
      <div class="wrap">
        <p>
          Los modelos van a cambiar cada pocos meses. La forma en que tu empresa los gobierna
          <span class="hl">no debería cambiar con ellos.</span>
        </p>
      </div>
    </section>

    <section class="section section--panel" aria-labelledby="porque-t">
      <div class="wrap">
        <p class="eyebrow">Por qué ahora</p>
        <h2 id="porque-t">El gateway es la base de la empresa <span class="hl">que usa IA en serio.</span></h2>
        <div class="cards cards--3">
          {porQue.map((p, i) => (
            <article class="card card--bar">
              <p class="kicker">{String(i + 1).padStart(2, '0')}</p>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- QUÉ PERMITE -->
    <section class="section grid-bg" id="que-permite" aria-labelledby="permite-t">
      <div class="glow glow--left" aria-hidden="true"></div>
      <div class="wrap">
        <div class="split">
          <div>
            <p class="eyebrow">Qué te permite</p>
            <h2 id="permite-t">Control total, <span class="hl">sin frenar a nadie.</span></h2>
          </div>
          <p class="intro">
            Los equipos siguen usando IA igual que hoy, o más. La diferencia es que ahora la empresa sabe qué
            pasa, cuánto cuesta y puede decidir.
          </p>
        </div>
        <div class="cards cards--3">
          {capacidades.map((c) => (
            <article class="card card--bar">
              <p class="kicker">{c.k}</p>
              <h3>{c.t}</h3>
              <p>{c.d}</p>
            </article>
          ))}
        </div>
        <ul class="roles">
          {roles.map((r) => (
            <li><strong>{r.k}</strong><span>{r.d}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CÓDIGO -->
    <section class="section" aria-labelledby="codigo-t">
      <div class="wrap split split--top">
        <div>
          <p class="eyebrow">Para tus desarrolladores</p>
          <h2 id="codigo-t">Pasarse al gateway es <span class="hl">cambiar una línea.</span></h2>
          <p class="intro">
            El gateway habla el mismo idioma que las APIs de OpenAI y Anthropic. Las aplicaciones existentes
            apuntan a una nueva dirección y siguen funcionando, con todos los controles activos.
          </p>
        </div>
        <pre class="code" aria-label="Ejemplo de código"><code><span class="c">// antes: cada app con su clave del proveedor</span>
<span class="k">const</span> client = <span class="k">new</span> OpenAI({'{'}
  apiKey: <span class="s">"clave-real-del-proveedor"</span>,
{'}'})

<span class="c">// con el gateway</span>
<span class="k">const</span> client = <span class="k">new</span> OpenAI({'{'}
  baseURL: <span class="s">"https://ai.tuempresa.com/v1"</span>,
  apiKey: <span class="s">"clave-del-equipo"</span>,
{'}'})

<span class="c">// "smart" lo define la empresa, no el código</span>
client.chat.completions.create({'{'}
  model: <span class="s">"smart"</span>, …
{'}'})</code></pre>
      </div>
    </section>

    <!-- CÓMO LO IMPLEMENTAMOS -->
    <section class="section section--panel" id="como" aria-labelledby="como-t">
      <div class="wrap center">
        <p class="eyebrow">Cómo lo implementamos</p>
        <h2 id="como-t">De la foto actual al gateway <span class="hl">en producción.</span></h2>
      </div>
      <div class="wrap">
        <ol class="timeline">
          {pasos.map((p, i) => (
            <li class="tl">
              <span class="tl__dot" aria-hidden="true"></span>
              <span class="tl__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))}
        </ol>
        <p class="note note--center">
          Somos agnósticos: tenemos un gateway propio listo para producción y, si tu empresa ya eligió otra
          herramienta, trabajamos sobre esa. Después de la puesta en marcha podemos seguir operándolo con vos.
        </p>
      </div>
    </section>

    <!-- EXPERIENCIA -->
    <section class="section" id="quien-lidera" aria-labelledby="lidera-t">
      <div class="wrap about">
        <div class="about__photo">
          <img src="/pablo.jpg" alt="Pablo Guzzi" width="480" height="480" />
        </div>
        <div class="about__text">
          <p class="eyebrow">Ya lo hicimos</p>
          <h2 id="lidera-t">No es teoría: <span class="hl">lo operamos a escala.</span></h2>
          <p>
            Pablo Guzzi lideró la implementación de un gateway de IA en una fintech a escala regional, que se
            convirtió en la base sobre la que se construyeron sus casos de IA en producción.
          </p>
          <p>
            Fue Chief Data &amp; AI Officer en Ualá entre 2021 y 2026 y, antes, Chief Data &amp; Analytics
            Officer en Naranja X. Está en cada proyecto, de la primera conversación a la puesta en producción.
          </p>
          <div class="actions">
            <a class="btn btn--ghost" href="/">Conocer a Pablo</a>
            <a class="more" href="/servicios">Ver todos los servicios <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- PREGUNTAS -->
    <section class="section section--panel" id="preguntas" aria-labelledby="faq-t">
      <div class="wrap split split--top">
        <div>
          <p class="eyebrow">Preguntas frecuentes</p>
          <h2 id="faq-t">Lo que todos <span class="hl">nos preguntan.</span></h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="final grid-bg" id="contacto" aria-labelledby="final-t">
      <div class="glow glow--final" aria-hidden="true"></div>
      <div class="wrap final__in">
        <p class="eyebrow">Contacto</p>
        <h2 id="final-t">Ordená la IA de tu empresa <span class="hl">antes de que escale.</span></h2>
        <p>Contanos qué modelos usan hoy y en qué equipos. Te respondemos personalmente con una propuesta.</p>
        <div class="actions actions--center">
          <a class="btn btn--glow" href={ctaHref} {...ext} data-cta="gw-final">Quiero mi gateway</a>
          <a class="btn btn--ghost" href="/servicios">Ver otros servicios</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <p><span class="mark mark--sm">guzzi<span class="mark__ai">AI</span></span></p>
      <p>Una iniciativa de <a href="/">{SITE.person}</a> y <a href="https://www.linkedin.com/in/dylanrosemberg/" target="_blank" rel="noopener">Dylan Rosemberg</a> · {SITE.city} · © {new Date().getFullYear()}</p>
      <p class="foot__legal">
        Las empresas mencionadas describen la trayectoria profesional de Pablo Guzzi. Ninguna participa de esta propuesta ni la avala. Las marcas de proveedores pertenecen a sus dueños.
      </p>
    </div>
  </footer>
</Base>
